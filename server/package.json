{
  "name": "pordo-service-server",
  "version": "0.1.0",
  "description": "Pordo content source service - comics first (Koa + TypeScript)",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "start": "cross-env NODE_ENV=production node dist/app.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-force-exit tests/*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cross-env": "^7.0.3",
    "koa": "^3.2.1",
    "koa-bodyparser": "^4.4.1",
    "reflect-metadata": "^0.2.2",
    "routing-controllers": "^0.11.3",
    "tough-cookie": "^5.1.2",
    "typedi": "^0.10.0",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@types/koa": "^3.0.3",
    "@types/koa__cors": "^5.0.0",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/node": "^24.10.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "prisma": "^6.19.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
