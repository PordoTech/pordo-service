# Copy to .env and adjust for local development. Never commit real secrets.
# Runtime data directory (database and master key). Defaults to server/data.
# PORDO_DATA_DIR=
# DATABASE_URL is resolved relative to server/prisma/, so ../data points at server/data.
DATABASE_URL="file:../data/pordo.db"
PORT=8790
HOST=127.0.0.1
# Master key: 32+ char secret. When unset, a restricted key file is created
# under PORDO_DATA_DIR/master.key. Backups must keep database + master key.
# PORDO_MASTER_KEY=
# PORDO_MASTER_KEY_FILE=
# Allow localhost/private upstreams (development and tests only).
# PORDO_ALLOW_PRIVATE_UPSTREAMS=1
